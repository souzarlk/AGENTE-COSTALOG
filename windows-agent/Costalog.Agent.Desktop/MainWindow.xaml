<Window x:Class="Costalog.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AGENTE COSTALOG" Height="820" Width="1380" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#111318" Foreground="#F3F4F6">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#191C23">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="22,24,18,22">
          <Border Width="42" Height="42" CornerRadius="10" Background="#C62828" HorizontalAlignment="Left">
            <TextBlock Text="C" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="AGENTE COSTALOG" FontSize="17" FontWeight="Bold" Margin="0,14,0,3"/>
          <TextBlock Text="PROTEÇÃO E GESTÃO DE ENDPOINTS" FontSize="9" Foreground="#9AA3B2"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="MONITORAMENTO" Foreground="#737D8D" FontSize="10" FontWeight="Bold" Margin="22,4,0,8"/>
          <Button Style="{StaticResource NavButton}" Content="▦  Visão geral" Tag="overview" Click="Navigate_Click" Background="#342126"/>
          <Button Style="{StaticResource NavButton}" Content="◉  Saúde do computador" Tag="health" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▤  Hardware e sistema" Tag="hardware" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▣  Armazenamento" Tag="storage" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⌁  Rede e conectividade" Tag="network" Click="Navigate_Click"/>
          <TextBlock Text="PROTEÇÃO" Foreground="#737D8D" FontSize="10" FontWeight="Bold" Margin="22,22,0,8"/>
          <Button Style="{StaticResource NavButton}" Content="♧  Certificados" Tag="certificates" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⊘  Sites e navegação" Tag="web" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▣  Dispositivos USB" Tag="usb" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="＋  Instalação de programas" Tag="software" Click="Navigate_Click"/>
          <TextBlock Text="ADMINISTRAÇÃO" Foreground="#737D8D" FontSize="10" FontWeight="Bold" Margin="22,22,0,8"/>
          <Button Style="{StaticResource NavButton}" Content="♙  Usuário e sessões" Tag="users" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⚑  Alertas e ocorrências" Tag="alerts" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⚙  Configurações" Tag="settings" Click="Navigate_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,18">
          <Border Height="1" Background="#30343E" Margin="0,0,0,14"/>
          <TextBlock Text="AGENTE LOCAL" Foreground="#9AA3B2" FontSize="10"/>
          <TextBlock x:Name="AgentStatusText" Text="Verificando serviço..." FontSize="12" Margin="0,5,0,0"/>
          <TextBlock Text="COSTALOG • Tecnologia da Informação" Foreground="#687181" FontSize="9" Margin="0,14,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,24">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="Resumo de segurança e funcionamento deste computador." Foreground="#9AA3B2" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock x:Name="DeviceNameText" Text="DISPOSITIVO" FontWeight="Bold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="LastUpdateText" Text="Dados locais" Foreground="#9AA3B2" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid x:Name="OverviewPanel">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="STATUS DO AGENTE" Foreground="#9AA3B2" FontSize="10"/><TextBlock x:Name="AgentMetric" Text="Aguardando" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Serviço de monitoramento" Foreground="#7E8795" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SISTEMA OPERACIONAL" Foreground="#9AA3B2" FontSize="10"/><TextBlock x:Name="OsMetric" Text="Windows" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Versão detectada localmente" Foreground="#7E8795" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="TEMPO LIGADO" Foreground="#9AA3B2" FontSize="10"/><TextBlock x:Name="UptimeMetric" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Desde a última inicialização" Foreground="#7E8795" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="POLÍTICA DE TI" Foreground="#9AA3B2" FontSize="10"/><TextBlock x:Name="PolicyMetric" Text="Pendente" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Última política sincronizada" Foreground="#7E8795" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="1" Background="#20232B" CornerRadius="10" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Computador monitorado" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="DeviceDetailsText" Text="As informações deste computador aparecerão aqui após a instalação e o registro do serviço." Foreground="#AAB2BF" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="PolicyDetailsText" Text="O aplicativo ainda não recebeu uma política central." Foreground="#8F99A8" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#20232B" CornerRadius="10" Padding="22">
              <StackPanel>
                <TextBlock Text="Próximos módulos" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="• Inventário completo de hardware e software&#10;• Saúde de discos e análise de espaço em disco&#10;• Políticas de certificados, navegação e USB&#10;• Alertas e administração pelo painel central" Foreground="#AAB2BF" LineHeight="25"/>
                <TextBlock Text="Os módulos são ativados somente após implementação, testes e autorização da TI." Foreground="#D8A7A7" FontSize="11" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="ModulePanel" Visibility="Collapsed" Background="#20232B" CornerRadius="10" Padding="24">
            <StackPanel>
              <TextBlock x:Name="ModuleTitle" Text="Módulo" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="ModuleDescription" Text="" Foreground="#AAB2BF" TextWrapping="Wrap" Margin="0,12,0,0"/>
              <TextBlock Text="Em desenvolvimento — esta seção será conectada ao serviço local e às políticas do painel central." Foreground="#D8A7A7" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
