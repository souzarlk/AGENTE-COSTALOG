<Application x:Class="Costalog.Agent.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="BrandRed">#C62828</Color>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandRed}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#17191F"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#20232B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>
    <Style TargetType="Button" x:Key="NavButton">
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style TargetType="Border" x:Key="MetricCard">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
  </Application.Resources>
</Application>
