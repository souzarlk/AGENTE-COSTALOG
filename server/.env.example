NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Endereco da API usado pelos computadores (gravado no instalador). Ex.: https://agente.costalog.com.br
PUBLIC_API_URL=
ALLOWED_ORIGINS=https://souzarlk.github.io
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=costalog_agent
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DB_NAME=costalog_agent
DB_SSL=false
CENTRAL_ADMIN_AUTH_SECRET=SET_EXACT_SAME_SECRET_AS_CENTRAL_NOTAS_FISCAIS
CENTRAL_TOKEN_ISSUER=costalog-central-notas-fiscais
DEVICE_TOKEN_PEPPER=REPLACE_WITH_RANDOM_32_BYTE_SECRET
ADMIN_SESSION_PEPPER=REPLACE_WITH_RANDOM_32_BYTE_SECRET
POLICY_SIGNING_PRIVATE_KEY_BASE64=
POLICY_SIGNING_PUBLIC_KEY_BASE64=
ENROLLMENT_TOKEN_MINUTES=60
HEARTBEAT_STALE_MINUTES=5
BROWSING_RETENTION_DAYS=90
TELEMETRY_RETENTION_DAYS=180
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AGENTE COSTALOG <ti@costalog.com.br>
SMTP_TO=ti@costalog.com.br

# Comma-separated exact Central identity subjects permitted to access the admin portal.
CENTRAL_ADMIN_SUBJECTS=replace-with-ti-admin-subjects

# Pasta onde o papel de parede enviado pelo painel e guardado (padrao: server/wallpaper)
WALLPAPER_DIR=
